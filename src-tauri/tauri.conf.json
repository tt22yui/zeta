{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeta",
  "version": "0.1.2",
  "identifier": "com.zeta.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5117",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zeta",
        "width": 1100,
        "height": 700,
        "minWidth": 760,
        "minHeight": 500,
        "decorations": false,
        "shadow": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#f6f6f8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
